{
  "name": "sighted-server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "echo Building server... && rm -f tsconfig.tsbuildinfo && npx tsc --listEmittedFiles 2>&1 && node -e \"const fs=require('fs'); if(!fs.existsSync('dist')){ console.error('ERROR: dist/ not found after tsc'); process.exit(1); }\"",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "scrape": "tsx scripts/scrape.ts",
    "scrape:full": "tsx scripts/scrape.ts --db",
    "scrape:muffler-man": "tsx scripts/scrape.ts --muffler-man",
    "scrape:maryland": "tsx scripts/scrape.ts --state md",
    "scrape:roadtrip": "tsx scripts/scrape.ts --state or wa nv az nm co ne sd wy ut --db",
    "import-scraped": "tsx scripts/import-scraped.ts",
    "import-muffler-man": "tsx scripts/import-muffler-man.ts",
    "import-maine": "tsx scripts/import-maine-attractions.ts",
    "import-south-dakota": "tsx scripts/import-south-dakota-attractions.ts",
    "import-california": "tsx scripts/import-california-attractions.ts",
    "import-texas": "tsx scripts/import-texas-attractions.ts",
    "import-missouri": "tsx scripts/import-missouri-attractions.ts",
    "import-maryland": "tsx scripts/import-maryland-attractions.ts",
    "import-new-york": "tsx scripts/import-new-york-attractions.ts",
    "fix-maine-state": "tsx scripts/fix-maine-state.ts",
    "ensure-attraction-media": "tsx scripts/ensure-attraction-media.ts",
    "dedupe-eddie-world": "tsx scripts/dedupe-eddie-world.ts",
    "dedupe-paul-bunyan-bangor": "tsx scripts/dedupe-paul-bunyan-bangor.ts",
    "dedupe-fremont-troll": "tsx scripts/dedupe-fremont-troll.ts",
    "geocode-attractions": "tsx scripts/geocode-attractions.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^2.1.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "axios": "^1.7.7",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
